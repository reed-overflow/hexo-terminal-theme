<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% const title = terminal_title(); const description = terminal_text(page.description || page.excerpt || config.description || (theme.hero || {}).description || '', 180); %>
<title><%= title %><%= !is_home() && config.title && title !== config.title ? ' | ' + config.title : '' %></title>
<meta name="description" content="<%= description %>">
<meta name="author" content="<%= (theme.author || {}).name || config.author || '' %>">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#101411">
<link rel="canonical" href="<%= page.permalink || full_url_for(page.path || '') %>">
<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:site_name" content="<%= config.title || 'Terminal' %>">
<meta property="og:url" content="<%= page.permalink || full_url_for(page.path || '') %>">
<meta name="twitter:card" content="<%= page.cover ? 'summary_large_image' : 'summary' %>">
<% if (page.cover && terminal_url(page.cover)) { %><meta property="og:image" content="<%= full_url_for(page.cover) %>"><% } %>
<% if (is_post()) { %>
<meta property="article:published_time" content="<%= date_xml(page.date) %>">
<meta property="article:modified_time" content="<%= date_xml(page.updated || page.date) %>">
<% } %>
<% if (theme.favicon && terminal_url(theme.favicon)) { %><link rel="icon" href="<%= terminal_url(theme.favicon) %>"><% } %>
<% if (theme.rss && terminal_url(theme.rss)) { %><link rel="alternate" type="application/atom+xml" title="<%= config.title %>" href="<%= terminal_url(theme.rss) %>"><% } %>
<script src="<%- url_for('/js/appearance.js') %>"></script>
<link rel="stylesheet" href="<%- url_for('/css/terminal.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/effects.css') %>" media="screen">
