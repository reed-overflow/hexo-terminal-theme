<% const comments = theme.comments || {}; if (comments.enabled && page.comments !== false && comments.repo && comments.repo_id && comments.category && comments.category_id) { %>
<section class="comments-section" aria-label="<%= tr('comments') %>"><h2 class="section-heading"><span class="prompt-dollar">#</span> <%= tr('comments') %></h2><div class="giscus" data-repo="<%= comments.repo %>" data-repo-id="<%= comments.repo_id %>" data-category="<%= comments.category %>" data-category-id="<%= comments.category_id %>" data-mapping="<%= comments.mapping || 'pathname' %>" data-lang="<%= comments.lang || 'en' %>"></div></section>
<% } %>
