<% const author = theme.author || {}; const sidebar = theme.sidebar || {}; const tocHtml = is_post() && (theme.post || {}).toc !== false && page.toc !== false ? toc(page.content, { list_number: false }) : ''; %>
<aside class="sidebar" aria-label="<%= tr('about') %>">
  <section class="profile-panel"><h2 class="panel-heading"><span aria-hidden="true">~/</span> whoami<span class="panel-index">01</span></h2><div class="profile-main"><% if (author.avatar && terminal_url(author.avatar)) { %><img class="avatar" src="<%= terminal_url(author.avatar) %>" alt="<%= author.name || config.author || '' %>" width="56" height="56" loading="lazy"><% } else { %><div class="avatar avatar-placeholder" aria-hidden="true">&gt;_</div><% } %><div><h3><%= author.name || config.author || 'Anonymous' %></h3><span class="profile-location"><span aria-hidden="true">⌁</span> <%= author.location || 'Earth' %></span></div></div><p class="profile-bio"><%= author.bio || config.description || '' %></p>
    <div class="profile-stats"><a href="<%- url_for('/archives/') %>"><strong><%= site.posts.length %></strong><span><%= tr('posts') %></span></a><a href="<%- url_for('/categories/') %>"><strong><%= site.categories.length %></strong><span><%= tr('categories') %></span></a><a href="<%- url_for('/tags/') %>"><strong><%= site.tags.length %></strong><span><%= tr('tags') %></span></a></div>
    <div class="social-links"><% (theme.social || []).forEach(function(item) { const href = terminal_url(item.url); if (!href) return; %><a href="<%= href %>" target="_blank" rel="me noopener noreferrer" aria-label="<%= item.name %>" title="<%= item.name %>"><span class="social-icon" aria-hidden="true"><%= item.icon || String(item.name).slice(0, 2) %></span><span><%= item.name %></span><span class="external-arrow" aria-hidden="true">↗</span></a><% }); %><% if (theme.rss && terminal_url(theme.rss)) { %><a href="<%= terminal_url(theme.rss) %>" aria-label="<%= tr('rss') %>"><span class="social-icon" aria-hidden="true">◔</span><span>RSS</span><span class="external-arrow" aria-hidden="true">↗</span></a><% } %></div>
  </section>
  <% if (tocHtml) { %><section class="toc-panel"><h2 class="panel-heading"><span aria-hidden="true">≡</span> <%= tr('toc') %></h2><nav class="desktop-toc" aria-label="<%= tr('toc') %>"><%- tocHtml %></nav></section><% } else { %>
  <% if (Number(sidebar.recent_posts) > 0 && site.posts.length) { %><section class="recent-panel"><h2 class="panel-heading"><span aria-hidden="true">↳</span> <%= tr('recent') %><span class="panel-index">02</span></h2><ol class="recent-list"><% site.posts.sort('-date').limit(Number(sidebar.recent_posts)).each(function(post, index) { %><li><span class="recent-number"><%= String(index + 1).padStart(2, '0') %></span><div><a href="<%- url_for(post.path) %>"><%= post.title || tr('untitled') %></a><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MMM DD, YYYY') %></time></div></li><% }); %></ol></section><% } %>
  <% if (Number(sidebar.tags) > 0 && site.tags.length) { %><section class="topics-panel"><h2 class="panel-heading"><span aria-hidden="true">#</span> <%= tr('topics') %><span class="panel-index">03</span></h2><div class="sidebar-tags"><% site.tags.sort('name', 1).limit(Number(sidebar.tags)).each(function(tag) { %><a href="<%- url_for(tag.path) %>"><%= tag.name %><span><%= tag.posts.length %></span></a><% }); %></div><a class="text-link" href="<%- url_for('/tags/') %>"><%= tr('all') %> →</a></section><% } %>
  <div class="sidebar-note" aria-hidden="true"></div>
  <% } %>
</aside>
