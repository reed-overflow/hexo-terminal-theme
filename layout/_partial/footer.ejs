<% const footer = theme.footer || {}; const counter = theme.counter || {}; const year = new Date().getFullYear(); const counterUrl = terminal_https(counter.url); %>
<footer class="site-footer">
  <% if ((theme.sidebar || {}).enabled === false) { %><div class="footer-social"><% (theme.social || []).forEach(function(item) { const href = terminal_url(item.url); if (!href) return; %><a href="<%= href %>" target="_blank" rel="me noopener noreferrer"><%= item.name %> ↗</a><% }); %><% if (theme.rss && terminal_url(theme.rss)) { %><a href="<%= terminal_url(theme.rss) %>" aria-label="<%= tr('rss') %>">RSS ↗</a><% } %></div><% } %>
  <% if (counter.enabled && counterUrl) { %><section class="visitor-counter" aria-label="<%= counter.title || 'Visitors' %>"><span class="counter-label"><span class="prompt-dollar">$</span> <%= counter.title || 'Visitors' %></span><% if (counter.type === 'iframe') { %><iframe src="<%= counterUrl %>" title="<%= counter.title || 'Visitors' %>" width="<%= Math.max(1, Number(counter.width) || 300) %>" height="<%= Math.max(1, Number(counter.height) || 100) %>" loading="lazy" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe><% } else { %><% if (terminal_https(counter.link)) { %><a href="<%= terminal_https(counter.link) %>" target="_blank" rel="noopener noreferrer"><% } %><img src="<%= counterUrl %>" alt="<%= counter.title || 'Visitors' %>" width="<%= Math.max(1, Number(counter.width) || 300) %>" height="<%= Math.max(1, Number(counter.height) || 100) %>" loading="lazy" referrerpolicy="no-referrer"><% if (terminal_https(counter.link)) { %></a><% } %><% } %></section><% } %>
  <div class="footer-row"><div><span class="footer-prompt" aria-hidden="true">&gt;_</span> © <%= footer.since && Number(footer.since) < year ? footer.since + '–' : '' %><%= year %> <%= (theme.author || {}).name || config.author || config.title %><span class="footer-text"><%= footer.text || '' %></span></div><div class="footer-credit"><%= tr('powered') %> <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a> <span>/</span> <a href="https://github.com/reed-overflow/hexo-terminal-theme/" target="_blank" rel="noopener noreferrer">Terminal Theme</a> </div></div>
  <% if (footer.icp) { %><p class="icp"><a href="<%= terminal_https(footer.icp_url) || 'https://beian.miit.gov.cn/' %>" target="_blank" rel="noopener noreferrer"><%= footer.icp %></a></p><% } %>
</footer>
