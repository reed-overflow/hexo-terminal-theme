<% const postSettings = theme.post || {}; const tocHtml = postSettings.toc !== false && page.toc !== false ? toc(page.content, { list_number: false }) : ''; %>
<article class="article" data-copy-label="<%= tr('copy') %>" data-copied-label="<%= tr('copied') %>" data-copy-error="<%= tr('copy_error') %>">
  <header class="article-header"><a class="text-link article-back" href="<%- url_for('/archives/') %>">← <%= tr('archives') %></a><p class="terminal-command"><span class="prompt-dollar">$</span> cat <%= page.slug || 'entry' %>.md</p><h1><%= page.title || tr('untitled') %></h1>
    <div class="article-meta"><span><%= tr('published') %> <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, config.date_format || 'YYYY-MM-DD') %></time></span><span><%= reading_time(page.content) %> <%= tr('minutes') %></span><% if (postSettings.show_updated !== false && page.updated && date(page.updated, 'YYYY-MM-DD') !== date(page.date, 'YYYY-MM-DD')) { %><span><%= tr('updated') %> <time datetime="<%= date_xml(page.updated) %>"><%= date(page.updated, config.date_format || 'YYYY-MM-DD') %></time></span><% } %></div>
    <% if (page.categories && page.categories.length) { %><div class="article-categories"><% page.categories.each(function(category) { %><a class="category-label" href="<%- url_for(category.path) %>"><%= category.name %></a><% }); %></div><% } %>
  </header>
  <% if (page.cover && terminal_url(page.cover)) { %><img class="article-cover" src="<%= terminal_url(page.cover) %>" alt="<%= page.cover_alt || page.title || '' %>" fetchpriority="high"><% } %>
  <% if (tocHtml) { %><details class="mobile-toc <%= (theme.sidebar || {}).enabled === false ? 'toc-always-visible' : '' %>"><summary><span aria-hidden="true">≡</span> <%= tr('toc') %></summary><nav aria-label="<%= tr('toc') %>"><%- tocHtml %></nav></details><% } %>
  <div class="prose" id="article-content"><%- page.content %></div>
  <footer class="article-footer"><div class="tag-list"><% if (page.tags) { page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a><% }); } %></div>
  <% if (postSettings.copyright !== false && page.copyright !== false) { %><div class="copyright-box"><p><span class="prompt-dollar">©</span> <%= tr('copyright') %> <strong><%= page.author || (theme.author || {}).name || config.author %></strong></p><p><%= tr('license') %> <% if (terminal_url(postSettings.license_url)) { %><a href="<%= terminal_url(postSettings.license_url) %>" target="_blank" rel="noopener noreferrer"><%= postSettings.license || 'CC BY-NC-SA 4.0' %> ↗</a><% } else { %><%= postSettings.license || 'CC BY-NC-SA 4.0' %><% } %></p><a class="permalink" href="<%= page.permalink %>"><%= page.permalink %></a></div><% } %>
  </footer>
  <nav class="post-navigation" aria-label="<%= tr('pagination') %>"><% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>" rel="prev"><span>← <%= tr('previous') %></span><strong><%= page.prev.title || tr('untitled') %></strong></a><% } else { %><span></span><% } %><% if (page.next) { %><a href="<%- url_for(page.next.path) %>" rel="next"><span><%= tr('next') %> →</span><strong><%= page.next.title || tr('untitled') %></strong></a><% } %></nav>
  <%- partial('_partial/comments') %>
</article>
